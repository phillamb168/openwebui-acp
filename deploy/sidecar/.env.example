OPENWEBUI_ACP_IMAGE=openwebui-acp-sidecar:0.1.0-rc.2
OPENWEBUI_URL=https://webui.example.org
OPENWEBUI_MODEL=your-workspace-model-id
OPENWEBUI_ACP_MEMORY_DEFAULT=false
OPENWEBUI_ACP_REQUIRED_TOOLS=
BUZZ_RELAY_URL=wss://relay.example.org
OPENWEBUI_ACP_BUZZ_ALLOWED_AUTHORS=<comma-separated-requester-public-keys>
OPENWEBUI_ACP_BUZZ_ALLOWED_CHANNELS=<comma-separated-channel-uuids>
