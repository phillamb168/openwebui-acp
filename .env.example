# Copy to an explicitly selected owner-only environment file; do not put real keys here.
OPENWEBUI_URL=https://webui.example.org
OPENWEBUI_MODEL=your-workspace-model-id
OPENWEBUI_API_KEY_FILE=/absolute/private/openwebui-key
# Set this only when the account's memory preference cannot be read through the API.
OPENWEBUI_ACP_MEMORY_DEFAULT=false

# Optional durable state. Omit for in-memory mappings.
# OPENWEBUI_ACP_STATE_DIR=/absolute/private/agent-state
# Optional required server tool IDs: fail before inference if unavailable.
# OPENWEBUI_ACP_REQUIRED_TOOLS=inventory,server:mcp:documents

# Optional Buzz mode. Both allowlists are mandatory; comma-separated.
# OPENWEBUI_ACP_BUZZ_AUTO_PUBLISH=true
# OPENWEBUI_ACP_BUZZ_ALLOWED_AUTHORS=<requester-64-character-hex-public-key>
# OPENWEBUI_ACP_BUZZ_ALLOWED_CHANNELS=<channel-uuid>
# BUZZ_RELAY_URL=wss://relay.example.org
# BUZZ_PRIVATE_KEY_FILE=/absolute/private/buzz-key
# Managed Buzz supplies BUZZ_PRIVATE_KEY; do not override it with another identity.
